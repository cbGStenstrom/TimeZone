@inherits CbPageBase
@page "/WorkItemManager"
@layout AppLayout

<div class="cb-workitem-manager">

<AppLayoutHeaderComponent>
	<h5 class="cb-margin-block-1px">Work Item Manager</h5>
</AppLayoutHeaderComponent>

<RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Style="padding:1rem 1rem 0;">

    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="@AlignItems.Center">
        <RadzenIcon Icon="assignment" Style="font-size:2rem;"></RadzenIcon>
        <RadzenButton Variant="Variant.Flat" Click="@((args) => { this.btnNewWorkItem_OnClick(); })">New Work Item</RadzenButton>

		<a href="/WorkItemHistory">History</a>
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap=".5rem">
        <RadzenButton Disabled=@SaveIsDisabled Variant="Variant.Flat"
                      ButtonStyle="ButtonStyle.Base"
                      Click="btnCancelSave_OnClick">Cancel</RadzenButton>
        <RadzenButton Disabled=@SaveIsDisabled Variant="Variant.Flat"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="btnSave_OnClick">Save</RadzenButton>
    </RadzenStack>

</RadzenRow>

<RadzenBody>

	<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

		<div style="width:50%">

			<WorkItemLookupFilter 
				OnFilterChange="OnWorkItemLookupFilterChange">
			</WorkItemLookupFilter>

			<RadzenTextBox Change="OnLookupKeywordChange" @bind-Value="@this._searchTerm">
			</RadzenTextBox>

		</div>

		<RadzenStack Orientation="Orientation.Horizontal">

			@* Workitem List *@
			<RadzenPanel AllowCollapse=false Style="width:50%">
				<RadzenDataGrid Style="height:620px;" TItem="WorkItem"
								AllowColumnResize="true"
								AllowAlternatingRows="false"
								AllowSorting="true"
								AllowPaging="true"
								AllowFiltering="true"
								FilterMode="FilterMode.Simple"
								PageSize="5000"
								PagerHorizontalAlign="HorizontalAlign.Left"
								ShowPagingSummary="true"
								Data="@this.FilteredQuery"
								LogicalFilterOperator="LogicalFilterOperator.Or"
								SelectionMode="DataGridSelectionMode.Single"
								RowSelect="@(args => this.gridRow_OnSelect(args))"
								@bind-Value="@this.SelectedWorkItems">
					<Columns>

						<RadzenDataGridColumn Property="@nameof(WorkItem.Title)" 
							FilterValue="@FilterTitle" 
							Filterable="false" 
							Title="Work Item Title"
							TextAlign="TextAlign.Left">
							<FilterTemplate>

								<RadzenDropDown 
									id="ddlWorkItem"
									AllowFiltering="true"
									AllowClear="true"
									@bind-Value=@SelectedProjectId 
									ClearSearchAfterSelection="true"
									Data="@this.ProjectList" 
									FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
									TextProperty="@nameof(Project.ShortName)"
									ValueProperty="@nameof(Project.Id)" 
									Style="width:100%" 
									Change="FilterProjectId_OnChange">
								</RadzenDropDown>
							</FilterTemplate>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn Property="@nameof(WorkItem.IsOpen)" 
							Filterable="false" 
							Title="Open" 
							Width="140px" 
							Sortable="false" 
							Reorderable="false" 
							Resizable="false" 
							TextAlign="TextAlign.Center">
							<FilterTemplate>
								<div>
									<RadzenDropDown Data="@(Enum.GetValues(typeof(IsOpenOptions)).Cast<Enum>())"
										@bind-Value="@this.FilterIsOpen"
										Change="FilterIsOpen_OnChange">
									</RadzenDropDown>
								</div>
							</FilterTemplate>
							<Template Context="data">
								<RadzenSwitch @bind-Value="@data.IsOpen" Disabled="true"></RadzenSwitch>
							</Template>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn Property="@nameof(WorkItem.IsBillable)" 
							Filterable="false" 
							Title="Billable"
							Width="150px" 
							Sortable="false" 
							Reorderable="false"
							Resizable="false"
							TextAlign="TextAlign.Center">
							<FilterTemplate>
								<div>
									<RadzenDropDown 
										Data="@(Enum.GetValues(typeof(IsBillableOptions)).Cast<Enum>())"
										@bind-Value="@this.FilterIsBillable"
										Change="FilterIsBillable_OnChange">
									</RadzenDropDown>
								</div>
							</FilterTemplate>
							<Template Context="data">
								<RadzenSwitch @bind-Value="@data.IsBillable" Disabled="true"></RadzenSwitch>
							</Template>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn Filterable="false"
								Width="50px" Sortable="false" Reorderable="false"
								Resizable="false">
							<Template Context="workitem">
								<RadzenButton Icon="delete_forever"
									Variant="Variant.Text" 
									ButtonStyle="ButtonStyle.Primary"
									Size="ButtonSize.Medium" 
									Click="@btnDeleteWorkItem_OnCLick"></RadzenButton>
	@* 							<RadzenButton Icon="assignment" 
									Variant="Variant.Text" 
									ButtonStyle="ButtonStyle.Primary" 
									Size="ButtonSize.Medium" 
									Click="@btnEditTimeEntries_OnClick"></RadzenButton> *@
							</Template>
						</RadzenDataGridColumn>

					</Columns>
				</RadzenDataGrid>
			</RadzenPanel>

			@* Workitem detail editor *@
			<RadzenPanel AllowCollapse="false" Style="width:50%">

				@if(this.ShowWorkItemEditor)
				{
					<RadzenText TextStyle="TextStyle.DisplayH5" Text="Work Item Editor"></RadzenText>
					<hr/>
						<WorkItemForm @ref="this.WorkItemFormRef" WorkItem="@this.SelectedWorkItems[0]" OnWorkItemChanged="WorkItemEditor_OnChanged"></WorkItemForm>
				}
				else if(this.ShowTimeEntryEditor)
				{
					<RadzenText TextStyle="TextStyle.DisplayH5" Text="Time Entry Editor"></RadzenText>
					<hr />
					<TimeEntryForm WorkItem="@this.SelectedWorkItems[0]" OnTimeEntryChanged="WorkItemEditor_OnChanged"></TimeEntryForm>
				}


			</RadzenPanel>

		</RadzenStack>

	</RadzenStack>

</RadzenBody>
</div>