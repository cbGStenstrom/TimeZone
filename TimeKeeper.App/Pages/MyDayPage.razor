@attribute [Route(PageUrls.MyDayPage)]
@using TimeKeeper.App.Components.MyDay
@inherits CbPageBase
@layout AppLayout

<PageTitle>My Day</PageTitle>

<RadzenLayout Style="height:100%;">

    <RadzenHeader Style="height:3.7rem;">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0rem" class="cb-pad-inline-start-1rem cb-pad-block-start-6px">

            <h5 class="cb-margin-block-1px"> My Day </h5>
            <span style="font-size:.85rem;"> @DateLabel </span>

        </RadzenStack>
    </RadzenHeader>

    <RadzenBody Style="padding:1rem;">

        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

            <CurrentActivityCardComponent 
                ActiveTimeEntry="@ActiveTimeEntry" 
                Width="33%"
                OnStopActivityClick="@CurrentActivity_OnStop">
            </CurrentActivityCardComponent>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.SpaceBetween">

                <ContinueWorkingComponent 
                    Activities="@RecentActivities"
                    Width="60%"
                    OnResumeWorkClicked="ResumeWork_Click">
                </ContinueWorkingComponent>


                <YesterdayAccomplishmentsCardComponent 
                    Activities="@this.YesterdayActivities"
                    Workday="@this.YesterdayWorkday"
                    Width="50%"
                    OnResumeWorkClicked="@this.ResumeWork_Click">
                </YesterdayAccomplishmentsCardComponent>

            </RadzenStack>
            <ActivitiesInReviewComponent
                Activities="@ReviewActivities"
                OnResumeWorkClicked="ResumeWork_Click"
                OnViewHistoryClicked="ViewHistory_Click" />
        </RadzenStack>

    </RadzenBody>

</RadzenLayout>

            
<TimeEntryEditorDialog @ref="@this.dlgTimeEntryEditor" />
