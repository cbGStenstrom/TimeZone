@using Radzen.Blazor.Spreadsheet.Tools
@using TimeKeeper.App.Models

<RadzenCard Style="@this.CardCssStyle" class="tz-card">

    <h5>Recent Activity</h5>

    <RadzenStack Orientation="Orientation.Vertical" Gap=".15rem">

        @foreach (var activity in Activities)
        {
            <RadzenStack 
                Orientation="@Orientation.Horizontal" 
                Gap="1rem" 
                AlignItems="@AlignItems.Center" 
                JustifyContent="@JustifyContent.SpaceBetween"
                style="padding:.5rem 0;border-bottom:1px solid #e0e0e0;">

                <RadzenStack Orientation="@Orientation.Horizontal" 
                    Gap=".3rem" 
                    AlignItems="@AlignItems.Center"
                    Style="max-width:60%;">

                    <RadzenMenu class="tz-popup-menu">
                        <RadzenMenuItem Icon="more_vert" class="tz-popup-menu-button">

                            <RadzenMenuItem Text="Resume Actvity" 
                                Value="1" 
                                Icon="play_arrow" 
                                Click="@(args => ResumeWork_OnClick(activity))">
                            </RadzenMenuItem>

                            <RadzenMenuItem Text="Show Notes"
                                Value="4"
                                Icon="notes"
                                Click="@(args => ShowNotes_OnClick(activity))">
                            </RadzenMenuItem>
                            
                            <RadzenMenuItem Text="Submit As PR"   
                                Value="2" 
                                Icon="fact_check" 
                                Visible="@this.ShowSubmitPrMenuItem(activity)">
                            </RadzenMenuItem>

                            <RadzenMenuItem Text="Reactivate Work Item" 
                                Value="3" 
                                Icon="undo" 
                                Visible="@this.ShowReactivateMenuItem(activity)">
                            </RadzenMenuItem>

                        </RadzenMenuItem>
                    </RadzenMenu>

                    <RadzenIcon Icon="@activity.WorkItem?.Type?.Icon" style="margin-right:.5rem;"></RadzenIcon>

                    <RadzenStack Orientation="@Orientation.Vertical" Gap="0" Style="max-width:100%;">
                        <div style="font-weight:600;line-height:1rem;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;cursor:default;" title="@activity.ActivityTitle">@activity.ActivityTitle</div>
                        <div style="font-size:.8rem;line-height:1rem;">@($"{activity.ActivityIdentifier} / {activity.WorkItem?.Project.ShortName}")</div>
                    </RadzenStack>


                </RadzenStack>

                <RadzenStack Orientation="@Orientation.Horizontal" 
                    Gap="1rem" 
                    AlignItems="@AlignItems.Center" 
                    JustifyContent="JustifyContent.End"
                    Style="width:25%;">

                    <div style="text-align:left;width:50%;font-size:.85rem; color:var(--rz-text-secondary-color); white-space:nowrap;min-width:6rem;">
                        @CalculateHowLongAgoDisplay(activity)
                    </div>

                    <div style="text-align:right;width:50%;font-weight:700;">
                        @CalculateDurationDisplay(activity)
                    </div>

                </RadzenStack>

            </RadzenStack>
        }

    </RadzenStack>

</RadzenCard>