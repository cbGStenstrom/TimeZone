@using TimeKeeper.App.Models

<RadzenCard>

    <RadzenText TextStyle="TextStyle.H5" Style="margin-bottom:2rem;">
        Continue Working
    </RadzenText>
    <RadzenStack Orientation="Orientation.Vertical" Gap=".15rem">

        @foreach (var activity in Activities)
        {
            <RadzenStack Orientation="@Orientation.Horizontal" Gap="1rem" AlignItems="@AlignItems.Center" JustifyContent="@JustifyContent.SpaceBetween">

                <RadzenStack Orientation="@Orientation.Horizontal" Gap=".3rem" AlignItems="@AlignItems.Center">
                    <RadzenButton Icon="play_arrow"
                        Variant="Variant.Text"
                        ButtonStyle="ButtonStyle.Success"
                        Size="ButtonSize.Small"
                        Click="@(() => ResumeWork_Click(activity))" />

                    <div>@($"{activity.ActivityIdentifier} {activity.ActivityTitle}")</div>
                </RadzenStack>

                <RadzenStack Orientation="@Orientation.Horizontal" Gap="1rem" AlignItems="@AlignItems.Center" JustifyContent="JustifyContent.Start">
                    <label>Last: </label>
                    <div style="font-size:.85rem; color:var(--rz-text-secondary-color); white-space:nowrap;min-width:6rem;">
                        @activity.LastWorkedDisplay
                    </div>
                </RadzenStack>

            </RadzenStack>
        }

    </RadzenStack>

</RadzenCard>