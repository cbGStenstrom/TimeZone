<RadzenCard Style="@this.CardCssStyle" class="tz-card">
    
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">

        <h5>Yesterday's Accomplishments</h5>
        <div>@($"{this.CalculateTotalTime()} hours")</div>
    </RadzenStack>

    @if (!this.Activities.Any())
    {
        <div>No accomplishments recorded for the previous workday.</div>
    }
    else
    {
        @foreach (var activity in this.Activities)
        {
            <RadzenStack Orientation="@Orientation.Horizontal"
                         AlignItems="@AlignItems.Center"
                         JustifyContent="@JustifyContent.SpaceBetween"
                         Gap="1rem">
                <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center">
                    <RadzenButton Icon="play_arrow"
                        title="Continue Working"
                        Variant="@Variant.Text"
                        ButtonStyle="@ButtonStyle.Success"
                        Size="@ButtonSize.Small"
                        Click="@(() => this.OnResumeWorkClicked.InvokeAsync(activity))"></RadzenButton>
                    <RadzenIcon Icon="@(activity.WorkItem.Type?.Icon ?? string.Empty)" title="@(activity.WorkItem?.Type?.Name)" Style="cursor:default;"></RadzenIcon>
                    <RadzenButton Style="text-align:start;"
                        Text="@this.GetDisplayName(activity)"
                        Variant="@Variant.Text"
                        Click="@(() => this.Activity_OnSelected(activity))">
                    </RadzenButton>
                </RadzenStack>
                <RadzenStack Orientation="@Orientation.Horizontal" AlignItems="@AlignItems.Center" Gap="1rem">
                    <div style="white-space:nowrap;">@activity.ProjectName</div>
                    <div style="width:75px;">@activity.TotalHoursWorked.ToString("0.##") hours</div>
                </RadzenStack>
            </RadzenStack>
        }
    }
</RadzenCard>
