@using TimeKeeper.App.Models

@if (Summary != null)
{
    <RadzenCard class="cb-activity-summary-card">

        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

            @* Header *@
            <RadzenRow AlignItems="AlignItems.Center"
                JustifyContent="JustifyContent.SpaceBetween">

                <RadzenStack Orientation="Orientation.Vertical" Gap=".25rem">
@* 
                    <RadzenText TextStyle="TextStyle.H5"> @Summary.ActivityIdentifier </RadzenText> *@

                    <RadzenText TextStyle="TextStyle.H5"> @Summary.ActivityTitle </RadzenText>

                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap=".5rem">

                    @if (Summary.IsBillable)
                    {
                        <RadzenBadge Text="Billable" BadgeStyle="BadgeStyle.Success" />
                    }

                    @if (Summary.IsInReview)
                    {
                        <RadzenBadge Text="In Review" BadgeStyle="BadgeStyle.Warning" />
                    }

                </RadzenStack>

            </RadzenRow>

            @* Summary Row *@
            <RadzenRow Gap="2rem">

                <RadzenColumn Size="3">

                    <RadzenText TextStyle="TextStyle.Overline">
                        Time Logged
                    </RadzenText>

                    <RadzenText TextStyle="TextStyle.H6">
                        @Summary.TotalHoursWorked.ToString("0.##") hrs
                    </RadzenText>

                </RadzenColumn>

                <RadzenColumn Size="3">

                    <RadzenText TextStyle="TextStyle.Overline">
                        Entries
                    </RadzenText>

                    <RadzenText TextStyle="TextStyle.H6">
                        @Summary.Entries.Count
                    </RadzenText>

                </RadzenColumn>

                <RadzenColumn Size="6">

                    <RadzenText TextStyle="TextStyle.Overline">
                        Last Worked
                    </RadzenText>

                    <RadzenText TextStyle="TextStyle.H6">
                        @Summary.LastWorked.ToString("g")
                    </RadzenText>

                </RadzenColumn>

            </RadzenRow>

            @* Accomplishments *@
            <RadzenCard Variant="Variant.Flat">

                <RadzenText TextStyle="TextStyle.Subtitle1">
                    Accomplishments
                </RadzenText>

                <RadzenStack Orientation="Orientation.Vertical"
                    Gap=".75rem"
                    Style="margin-top:.75rem;">

                    @foreach (var entry in Summary.Entries)
                    {
                        <div class="cb-accomplishment-entry">

                            <RadzenRow AlignItems="AlignItems.Start">

                                <RadzenColumn Size="2">

                                    <RadzenText TextStyle="TextStyle.Caption">
                                        @entry.StartWork?.ToString("h:mm tt")
                                    </RadzenText>

                                </RadzenColumn>

                                <RadzenColumn Size="10">

                                    <RadzenText TextStyle="TextStyle.Body2">
                                        @entry.Accomplishment
                                    </RadzenText>

                                </RadzenColumn>

                            </RadzenRow>

                        </div>
                    }

                </RadzenStack>

            </RadzenCard>

            @* Actions *@
            <RadzenRow JustifyContent="JustifyContent.End"
                Gap=".5rem">

                <RadzenButton Text="Resume Work"
                    Icon="play_arrow"
                    ButtonStyle="ButtonStyle.Success"
                    Click="@ResumeWork_Click" />

                <RadzenButton Text="View History"
                    Icon="history"
                    ButtonStyle="ButtonStyle.Light"
                    Click="@ViewHistory_Click" />

            </RadzenRow>

        </RadzenStack>

    </RadzenCard>
}