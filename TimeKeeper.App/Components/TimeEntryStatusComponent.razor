@using TimeKeeper.App.Components.Dialogs
@inherits CbComponentBase

@{
    var activeTimeEntry = this.ActiveTimeEntry;
}

<RadzenStack 
    Orientation="@this.StatusOrientation"
    class="cb-time-entry-status-component"
    AlignItems="@this.StatusAlignItems"
    JustifyContent="@JustifyContent.Start">

    @if (activeTimeEntry != null)
    {
        <div class="cb-button" @onclick="@(async () => { await btnEndWork_OnClick(); })">Edit Work</div>

        @if (this.ShowSeparators)
        {
            <div class="cb-vert-separator"></div>
        }

        <RadzenStack Orientation="@Orientation.Horizontal" Gap=".25rem" AlignItems="@AlignItems.Center" class="cb-label-message">
            <label>Workitem:</label>
            <span class="cb-message">@($"{activeTimeEntry.WorkItem?.DisplayIdentifier} {activeTimeEntry.WorkItem?.Title}")</span>
        </RadzenStack>

        <RadzenStack Orientation="@Orientation.Horizontal" Gap=".25rem" AlignItems="@AlignItems.Center" class="cb-label-message">
            <label>Start Time:</label>
            <span class="cb-message">@activeTimeEntry.StartWork?.ToString("g")</span>
        </RadzenStack>
    }
    else
    {
        <div class="cb-button" @onclick="@(async () => { await btnStartWork_OnClick(); })">Start Work</div>
    }

    <TimeEntryEditorDialog 
        @ref="dlgTimeEntryEditor"
        OnSaveCallback="@Dialog_OnTimeEntryEnded">
    </TimeEntryEditorDialog>

</RadzenStack>
