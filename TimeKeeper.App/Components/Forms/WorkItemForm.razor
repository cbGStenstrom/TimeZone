
@if (this.WorkItem != null)
{
	<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

		@* Project  *@
		<RadzenRow AlignItems="AlignItems.Center">
			<RadzenColumn Size="2">
				<RadzenLabel Text="Project"></RadzenLabel>
			</RadzenColumn>
			<RadzenColumn Size="10">
				<RadzenDropDown Data="@this.ProjectList" 
								@bind-Value="@this.WorkItem.ProjectId"
								Style="width:100%;"
								Placeholder="Select Product"
								AllowClear=true
								Change="@Form_OnChange"
								ValueProperty="@nameof(Domain.Models.Project.Id)">
					<Template>
						<div>@($"[{(context as Domain.Models.Project)?.Key}] {(context as Domain.Models.Project)?.LongName}")</div>
					</Template>
				</RadzenDropDown>

				@if (this.WorkItem.ProjectId == 0 && this.ShowValidation)
				{
					<RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-danger);">
						Project is required.
					</RadzenText>
				}
			</RadzenColumn>
		</RadzenRow>

		@* Work Item Type *@
		<RadzenRow AlignItems="AlignItems.Center">
			<RadzenColumn Size="2">
				<RadzenLabel Text="Type" Component="ddlWorkItemType"></RadzenLabel>
			</RadzenColumn>
			<RadzenColumn Size="10">
				<RadzenDropDown Data="@this.WorkItemTypes"
									@bind-Value="@this.WorkItem.WorkItemType"
									Name="ddlWorkItemType"
									Style="width:100%;"
									Placeholder="Select Type"
									AllowClear="false"
									Change="@Form_OnChange">
				</RadzenDropDown>
				@if (this.WorkItem.WorkItemType == null && this.ShowValidation)
				{
					<RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-danger);">Work Item Type is required.</RadzenText>
				}
			</RadzenColumn>
		</RadzenRow>

        @* Activity Number *@
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="2">
                <RadzenLabel Text="Activity Number"></RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="10">
				<RadzenTextBox Style="width:100%;"
					@bind-Value="@this.WorkItem.ActivityNumber"
					Change="@Form_OnChange"
					MaxLength="50">
				</RadzenTextBox>

				@if (string.IsNullOrWhiteSpace(this.WorkItem.ActivityNumber) && this.ShowValidation)
				{
					<RadzenText TextStyle="TextStyle.Caption"Style="color:var(--rz-danger);">
						Activity Number is required.
					</RadzenText>
				}
            </RadzenColumn>
        </RadzenRow>

		@* Title *@
		<RadzenRow AlignItems="AlignItems.Center">
			<RadzenColumn Size="2">
				<RadzenLabel Text="Title"></RadzenLabel>
			</RadzenColumn>
			<RadzenColumn Size="10">
				<RadzenTextBox Style="width:100%;" 
					@bind-Value="@this.WorkItem.Title" 
					Change="@Form_OnChange" 
					MaxLength="250">
				</RadzenTextBox>

				@if (string.IsNullOrWhiteSpace(this.WorkItem.Title) && this.ShowValidation)
				{
					<RadzenText TextStyle="TextStyle.Caption" Style="color:var(--rz-danger);">
						Title is required.
					</RadzenText>
				}
			</RadzenColumn>
		</RadzenRow>

		@* Complete/Incomplete *@
		<RadzenRow AlignItems="AlignItems.Center">
			<RadzenColumn Size="2">
				<RadzenLabel Text="Is Open" Component="chkIsOpen"></RadzenLabel>
			</RadzenColumn>
			<RadzenColumn Size="10">
				<RadzenSwitch @bind-Value="@this.WorkItem.IsOpen" Name="chkIsOpen" Change="@Form_OnChange"></RadzenSwitch>
			</RadzenColumn>
		</RadzenRow>

		@* IsInReview *@
		<RadzenRow AlignItems="AlignItems.Center">
			<RadzenColumn Size="2">
				<RadzenLabel Text="Is In Review" Component="chkIsInReview"></RadzenLabel>
			</RadzenColumn>
			<RadzenColumn Size="10">
				<RadzenSwitch @bind-Value="@this.WorkItem.IsInReview" Name="chkIsInReview" Change="@Form_OnChange"></RadzenSwitch>
			</RadzenColumn>
		</RadzenRow>

		@* Billable *@
		<RadzenRow AlignItems="AlignItems.Center">
			<RadzenColumn Size="2">
				<RadzenLabel Text="Billable" Component="chkIsBillable"></RadzenLabel>
			</RadzenColumn>
			<RadzenColumn Size="10">
				<RadzenSwitch @bind-Value="@this.WorkItem.IsBillable" Name="chkIsBillable" Change="@Form_OnChange"></RadzenSwitch>
			</RadzenColumn>
		</RadzenRow>

		@* Description *@
		<RadzenRow AlignItems="AlignItems.Start">
			<RadzenColumn Size="2" >
				<RadzenLabel Text="Description"></RadzenLabel>
			</RadzenColumn>
			<RadzenColumn Size="10">
				<RadzenTextArea @bind-Value="@this.WorkItem.Description" Style="width: 100%; height:7.1rem;" aria-label="TextArea" Change="@Form_OnChange" />
			</RadzenColumn>
		</RadzenRow>

	</RadzenStack>
}