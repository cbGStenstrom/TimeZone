			TValue="@WorkItem"
			AllowFiltering="true"
			FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
			FilterOperator="StringFilterOperator.Contains"
			@bind-SearchText="@WorkItemSearchTerm"
			@bind-Value="@SelectedWorkItem"
			ValueProperty="@nameof(WorkItem.Id)"
			TextProperty="@nameof(WorkItem.Title)"
			Style="width:100%;">
		</RadzenDropDown> *@
	</RadzenColumn>
