@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits LayoutComponentBase
<RadzenDialog />
<RadzenLayout Style="display:grid;height:100vh;">

    <RadzenSidebar 
        FullHeight="true" 
        Position="@SidebarPosition.Left" 
        Responsive="false" 
        Style="width:max-content;"
        class="cb-sidepanel-main-nav">
        <RadzenPanelMenu 
            DisplayStyle="@(LeftSidebarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)"
            Style="@(LeftSidebarExpanded? "width: 250px;" : "width: max-content;")"
            ShowArrow="false">
            <RadzenPanelMenuItem 
                Text="timezone" 
                Click="@(() => LeftSidebarExpanded = !LeftSidebarExpanded)"
                IconColor="var(--rz-base-50)"
                class="cb-brand">
            </RadzenPanelMenuItem>

            
            <RadzenPanelMenuItem Text="My Day"          Icon="home"         class="cb-font-button" Click="@((args) => { this.lnkMyDay_OnClick(); })" />
            <RadzenPanelMenuItem Text="Dashboard"       Icon="dashboard"    class="cb-font-button" Click="@((args) => { this.btnDashboard_OnClick(); })" />
            <RadzenPanelMenuItem Text="Workitem Mgr"    Icon="assignment"   class="cb-font-button" Click="@((args) => { this.lnkWorkItems_OnClick(true); })" />
            <RadzenPanelMenuItem Text="Time Entries"    Icon="schedule"     class="cb-font-button" Click="@((args) => { this.lnkTimeEntries_OnClick(); })" />
            <RadzenPanelMenuItem Text="Log Out"         Icon="logout"       class="cb-font-button" Click="@((args) => { this.lnkLogOut_OnClick(); })" />
            <RadzenPanelMenuItem Text="Settings"        Icon="settings"     class="cb-font-button" >
                <RadzenPanelMenuItem Text="Project Mgr"         Icon="cases"    class="cb-font-button" Click="@((args) => { this.lnkProjectMgr_OnClick(); })" />
                <RadzenPanelMenuItem Text="Activity Type Mgr"   Icon="category" class="cb-font-button" Click="@(() => NavigationMgr?.NavigateTo("/ActivityTypeManager"))" />
            </RadzenPanelMenuItem>

        </RadzenPanelMenu>
    </RadzenSidebar>
    
    <RadzenBody Style="padding:0;">
        <CascadingValue Value="this" Name="Layout">
            <CascadingValue Value="this.ActiveTimeEntry" Name="ActiveTimeEntry">
                @Body
            </CascadingValue>
        </CascadingValue>
    </RadzenBody>
    
    <RadzenFooter>
        <TimeEntryStatusComponent Gap=".5rem"
            @bind-ActiveTimeEntry="@this.ActiveTimeEntry" 
            StatusOrientation="@Orientation.Horizontal" 
            OnTimeEntryChanged="@TimeEntryStatusComponent_OnTimeEntryChanged">
        </TimeEntryStatusComponent>
    </RadzenFooter>

</RadzenLayout>
